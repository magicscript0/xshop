# Public Supabase project configuration used by the XSHOP browser client.
# These values are publishable; never put a service_role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Existing GenAxis AI workspace only. Optional for XSHOP; keep configured only
# while the legacy /genaxis and /ai routes are in use.
VITE_CLERK_PUBLISHABLE_KEY=
